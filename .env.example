# Copy to .env. Every value is optional.

# API server
PORT=8787
HOST=127.0.0.1
# CODEIMPACT_DATA_DIR=./data

# GitHub: raises the API rate limit and enables private repositories the token can read.
# Read-only "Contents" and "Pull requests" permissions are sufficient.
GITHUB_TOKEN=

# Enables POST /api/webhooks/github (pull_request events, HMAC-verified).
GITHUB_WEBHOOK_SECRET=

# Local checkouts that may be analyzed, as name=path pairs separated by semicolons.
# CODEIMPACT_LOCAL_REPOS=itsdangerous=C:/src/itsdangerous;app=../my-app

# Analysis limits and worker
# CODEIMPACT_MAX_DEPTH=8
# CODEIMPACT_WORKER=external   # run `npm run worker` separately instead of in the API process
# CODEIMPACT_MAX_ATTEMPTS=3
# CODEIMPACT_JOB_TIMEOUT_MS=600000

# Benchmark clone location (defaults to data/bench/itsdangerous)
# CODEIMPACT_BENCHMARK_REPO=
